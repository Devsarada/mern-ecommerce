# .env.example  ->  copy karke .env banaiye:  cp .env.example .env
# Asli values sirf .env mein. .env kabhi Git mein nahi jaata (.gitignore mein hai).
# Password/secret generate karne ke liye (sirf letters+numbers, URL mein safe):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# =====================================================================
# A) Dono jagah kaam aate hain: laptop (npm run dev) + Docker Compose
# =====================================================================
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe test key, ya placeholder agar Stripe account nahi hai
STRIPE_SECRET_KEY=sk_test_placeholder_not_real

# =====================================================================
# B) Sirf laptop par "npm run dev" ke liye (Compose inhe use NAHI karta)
# =====================================================================
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@staging-cluster.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority
UPSTASH_REDIS_URL=redis://localhost:6379

# =====================================================================
# C) Sirf Docker Compose ke liye
# =====================================================================
# Browser kis port par khulega, aur Stripe redirect kahan aayega (dono match hone chahiye)
FRONTEND_PORT=8080
CLIENT_URL=http://localhost:8080

# MongoDB container: root (sirf admin kaam) + app user (sirf ecommerce DB)
# NOTE: ye users sirf PEHLI baar (khaali volume) bante hain
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=generate-a-hex-password
MONGO_APP_USERNAME=mern_app
MONGO_APP_PASSWORD=generate-another-hex-password

# Redis container ka password
REDIS_PASSWORD=generate-a-hex-password

# Seed script ka admin user (password kam se kam 12 characters)
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=generate-a-strong-password