# frontend/nginx/default.conf.template
# Container start hote waqt nginx image ka entrypoint ${...} wali values (env variables)
# bhar kar isse /etc/nginx/conf.d/default.conf bana deta hai.
#   BACKEND_HOST           -> backend ka address (Compose: backend:5000, K8s: backend.mern.svc.cluster.local:5000)
#   NGINX_LOCAL_RESOLVERS  -> container ka DNS server (entrypoint /etc/resolv.conf se khud bharta hai)

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;                 # nginx ka version response mein mat batao
    client_max_body_size 10m;          # product image upload (backend ki limit bhi 10mb)

    # DNS runtime par resolve karo: backend abhi na ho to bhi nginx start ho jaaye (502 dega, crash nahi)
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    # Compression: JS/CSS ka size ~70% kam
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Health check (Docker HEALTHCHECK, Kubernetes probes)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API -> backend (reverse proxy)
    location /api/ {
        set $backend_upstream http://${BACKEND_HOST};
        proxy_pass $backend_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # Vite ki hashed files (index-AbC123.js): naam badalta hai to 1 saal cache safe
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # React SPA: koi bhi route (/cart, /purchase-success) -> index.html
    # index.html cache nahi, taaki naya deploy turant dikhe
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}